{
  "entities": {
    "PartListing": {
      "title": "Part Listing",
      "description": "Auto or truck spare part listing in marketplace",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "vehicleType": { "type": "string", "enum": ["Car", "Truck", "Both", "Other"] },
        "condition": { "type": "string", "enum": ["New", "Like New", "Good", "Fair", "Refurbished", "For Parts"] },
        "price": { "type": "number" },
        "location": { "type": "string", "maxLength": 100 },
        "partNumber": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 100 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerBusinessName": { "type": "string", "maxLength": 100 },
        "sellerPhone": { "type": "string", "maxLength": 30 },
        "sellerEmail": { "type": "string", "maxLength": 100 },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "compatibility": { "type": "string", "maxLength": 500 }
      },
      "required": ["title", "description", "category", "price", "sellerId", "sellerPhone"]
    },
    "Seller": {
      "title": "Seller Profile",
      "description": "Spare parts seller profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "businessName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["name", "email", "phone"]
    },
    "User": {
      "title": "User Profile",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SubscriptionSettings": {
      "title": "Subscription Settings & Banking Details",
      "description": "Protected owner banking details and subscription settings",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 100 },
        "accountHolder": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "branchCode": { "type": "string", "maxLength": 20 },
        "accountType": { "type": "string", "maxLength": 50 },
        "referenceFormat": { "type": "string", "maxLength": 100 },
        "monthlyFeeZar": { "type": "number" },
        "ownerPasscode": { "type": "string", "maxLength": 100 }
      }
    },
    "PartRequest": {
      "title": "Part Sourcing Request",
      "description": "Customer and buyer spare part sourcing broadcast requests",
      "type": "object",
      "properties": {
        "partName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "vehicleType": { "type": "string", "enum": ["Car", "Truck", "Both", "Other"] },
        "vehicleMake": { "type": "string", "maxLength": 100 },
        "vehicleModel": { "type": "string", "maxLength": 100 },
        "vehicleYear": { "type": "string", "maxLength": 20 },
        "engineCodeOrVin": { "type": "string", "maxLength": 100 },
        "partNumber": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "urgency": { "type": "string", "enum": ["urgent", "standard", "flexible"] },
        "targetBudgetZar": { "type": "number" },
        "province": { "type": "string", "maxLength": 50 },
        "town": { "type": "string", "maxLength": 100 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "buyerPhone": { "type": "string", "maxLength": 30 },
        "buyerEmail": { "type": "string", "maxLength": 100 },
        "preferredContact": { "type": "string", "enum": ["whatsapp", "call", "email"] },
        "status": { "type": "string", "enum": ["open", "quotes_received", "fulfilled", "closed"] },
        "quotesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["partName", "category", "vehicleMake", "vehicleModel", "province", "town", "buyerName", "buyerPhone"]
    },
    "TestConnection": {
      "title": "Test Connection",
      "description": "Connection test doc for Firestore health checks",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "ProofOfPayment": {
      "title": "Proof of Payment",
      "description": "Uploaded proof of payment for EFT transfers with seller notification",
      "type": "object",
      "properties": {
        "reference": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "purpose": { "type": "string", "enum": ["subscription", "part_purchase", "general"] },
        "payerName": { "type": "string", "maxLength": 100 },
        "payerContact": { "type": "string", "maxLength": 100 },
        "payerNotes": { "type": "string", "maxLength": 1000 },
        "bankPaidFrom": { "type": "string", "maxLength": 50 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "fileDataUrl": { "type": "string" },
        "fileType": { "type": "string", "maxLength": 50 },
        "targetSellerId": { "type": "string", "maxLength": 128 },
        "targetSellerName": { "type": "string", "maxLength": 100 },
        "listingId": { "type": "string", "maxLength": 128 },
        "listingTitle": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["reference", "amount", "payerName", "payerContact", "fileName"]
    },
    "SellerNotification": {
      "title": "Seller Notification",
      "description": "Realtime notification sent to seller or system upon POP upload or request quote",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["payment_proof", "part_request", "inquiry", "subscription"] },
        "relatedId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "reference": { "type": "string", "maxLength": 100 },
        "fileDataUrl": { "type": "string" },
        "fileName": { "type": "string", "maxLength": 200 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "payerName": { "type": "string", "maxLength": 100 },
        "payerContact": { "type": "string", "maxLength": 100 }
      },
      "required": ["sellerId", "title", "message", "type"]
    }
  },
  "firestore": {
    "/payment_proofs/{popId}": {
      "schema": { "$ref": "#/entities/ProofOfPayment" },
      "description": "Uploaded proof of payment records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/SellerNotification" },
      "description": "Direct notifications for sellers and admin"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/PartListing" },
      "description": "Public marketplace listings for spare parts"
    },
    "/part_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PartRequest" },
      "description": "Customer and buyer spare part sourcing broadcast requests"
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/entities/Seller" },
      "description": "Seller directory and profiles"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SubscriptionSettings" },
      "description": "Application owner settings and banking configurations"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Connection test doc for Firestore health checks"
    }
  }
}
